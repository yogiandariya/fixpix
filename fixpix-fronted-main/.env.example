# FixPix Website Environment Variables
# Copy this file to .env and update values as needed

# Backend API URL (Django)
# For local development:
VITE_API_URL=http://localhost:8000
# For production:
# VITE_API_URL=https://fixpix-backend-production.up.railway.app

# Media URL (usually same as API URL)
VITE_MEDIA_URL=http://localhost:8000

# Node Intelligence API URL
# For local development:
VITE_NODE_API_URL=http://localhost:4000
# For production:
# VITE_NODE_API_URL=https://fixpix-intelligence-production.up.railway.app

# Supabase (Auth + DB)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
